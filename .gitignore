# Large binary assets are tracked via Git LFS — these are local-only
packages/assets/_raw/
packages/assets/_cache/

# Claude Code personal settings (allowlist of tool permissions per developer)
.claude/settings.local.json

# Simulator runtime data — observation/experiment stores (JSON, can reach 100s of MB)
**/.data/
# Accidental nested cwd when BFF is started from the repo root
apps/sim-bff/apps/

# Local design references (binaries — see CLAUDE.md; use Git LFS under packages/assets if needed)
_reference/

# Sentry source maps (uploaded, not committed)
.sentryclirc

# Vercel / deployment
.vercel/
.wrangler/
.fly/
