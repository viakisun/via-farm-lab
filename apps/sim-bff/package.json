{
  "name": "@via-farm-lab/sim-bff",
  "version": "0.0.0",
  "private": true,
  "description": "Simulator BFF — Fastify server exposing 5 external API surfaces (Console/Backend/Robot/Subscription/Growth) backed by a physics/chemistry/biology simulator. Mock-first; real adapters slot in later.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cors": "catalog:",
    "@fastify/helmet": "catalog:",
    "@fastify/rate-limit": "catalog:",
    "@fastify/websocket": "catalog:",
    "@via-farm-lab/api-contracts": "workspace:*",
    "@via-farm-lab/sim-core": "workspace:*",
    "@via-farm-lab/telemetry": "workspace:*",
    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "prom-client": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@types/ws": "catalog:"
  }
}
