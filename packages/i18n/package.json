{
  "name": "@via-farm-lab/i18n",
  "version": "0.0.0",
  "private": true,
  "description": "Localisation — en-AU primary, ko-KR secondary. i18next + react-i18next. AU spelling enforced. Glossary mirrors LOCALISATION.md §2.3.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./locales/*": "./src/locales/*"
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:spelling": "node scripts/check-au-spelling.mjs"
  },
  "dependencies": {
    "i18next": "catalog:",
    "i18next-browser-languagedetector": "catalog:",
    "react-i18next": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
