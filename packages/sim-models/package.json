{
  "name": "@via-farm-lab/sim-models",
  "version": "0.0.0",
  "private": true,
  "description": "Physics / chemistry / biology models for the simulator. Plant biomass, EC/pH chemistry, flow, CO₂ dispersion, temp/humidity, PAR, robot kinematics, scan measurement.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
